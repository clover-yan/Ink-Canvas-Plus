<Window x:Class="InkCanvasPlus.ColorConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        ui:ThemeManager.RequestedTheme="Light"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Title="配置画笔颜色" Height="380" Width="500"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="点击色块挑选颜色，或输入 #AARRGGBB 格式的十六进制颜色值" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
                <GroupBox Grid.Column="0" Header="黑板模式颜色">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="红色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderLightRed" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="L0" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxLightRed" Tag="L0" Text="#FFFF3333" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="绿色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderLightGreen" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="L1" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxLightGreen" Tag="L1" Text="#FF1ED760" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="蓝色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderLightBlue" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="L2" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxLightBlue" Tag="L2" Text="#FF239AD6" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="黄色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderLightYellow" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="L3" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxLightYellow" Tag="L3" Text="#FFFFC000" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="桌面批注和白板模式颜色">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="红色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderDarkRed" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="D0" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxDarkRed" Tag="D0" Text="#FFFF0000" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="绿色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderDarkGreen" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="D1" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxDarkGreen" Tag="D1" Text="#FF169141" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="蓝色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderDarkBlue" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="D2" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxDarkBlue" Tag="D2" Text="#FF239AD6" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="黄色" Width="40" VerticalAlignment="Center" />
                            <Border x:Name="BorderDarkYellow" Width="36" Height="36" CornerRadius="6" BorderBrush="#40000000" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="ColorSwatch_MouseUp" Tag="D3" ToolTip="点击选择颜色" />
                            <TextBox x:Name="TextBoxDarkYellow" Tag="D3" Text="#FFF38B00" Width="104" Margin="8,0,0,0" VerticalContentAlignment="Center" LostFocus="HexTextBox_LostFocus" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="恢复默认" Click="BtnResetDefault_Click" Height="30" Width="100" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Border Name="BorderSavedIndicator" VerticalAlignment="Center" Width="30" Height="30" Opacity="0" ToolTip="已保存">
                    <Viewbox Margin="6">
                        <ui:SymbolIcon Symbol="Accept" />
                    </Viewbox>
                </Border>
                <Button Content="保存" Click="BtnSave_Click" Height="30" Width="100" Margin="0,0,10,0" />
                <Button Content="关闭" Height="30" Width="100" Click="BtnClose_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
