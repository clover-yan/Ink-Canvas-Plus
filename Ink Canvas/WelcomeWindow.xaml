<Window x:Class="InkCanvasPlus.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:local="clr-namespace:InkCanvasPlus"
        mc:Ignorable="d"
        Title="欢迎使用 Ink Canvas Plus"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Ink Canvas Plus 已更新到 " FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 10 0 10"/>
            <TextBlock Name="TextBlockVersion" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 10 10 10"/>
        </StackPanel>
        <Ellipse Grid.Column="0" Grid.Row="1" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush Stretch="UniformToFill">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/Clover Yan.png" DecodePixelWidth="240" DecodePixelHeight="240" />
                    </ImageBrush.ImageSource>
                </ImageBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Image Grid.Column="0" Grid.Row="2" Width="128" Height="128" Stretch="UniformToFill">
            <Image.Source>
                <BitmapImage DecodePixelWidth="256" DecodePixelHeight="256" UriSource="pack://application:,,,/Resources/InkCanvas.png" />
            </Image.Source>
        </Image>
        <Grid Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0">
                <TextBlock Name="TextBlockUpdateContent" TextWrapping="Wrap" FontSize="14"/>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10">
                <ui:HyperlinkButton Name="HyperlinkButtonWebsite" Content="https://cloveryan.com/ic+" Click="HyperlinkButtonWebsite_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10">
                <Button Name="ButtonShowMore" Content="显示更多" Width="100" Height="30" Click="ButtonShowMore_Click" Margin="0 0 10 0"/>
                <Button Name="ButtonClose" Content="关闭" Width="100" Height="30" Click="ButtonClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
